# cp .env.example .env, then fill in. Names map to Settings (src/api/config.py).

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Set the POSTGRES_* parts, or DATABASE_URL to override them entirely.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

JWT_SECRET=change-me-to-a-long-random-string  # openssl rand -hex 32
ACCESS_TOKEN_TTL_MINUTES=10080
COOKIE_SECURE=false  # true in production (HTTPS)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.sikto.com  # when web + API share a parent domain

LOG_LEVEL=INFO
LOG_FORMAT=text  # text | json
# LOG_DIR=.logs

AGENT_PROVIDER=deepseek  # deepseek | openai | anthropic | custom
# AGENT_MODEL=  # blank = provider default
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AGENT_BASE_URL=  # for AGENT_PROVIDER=custom (OpenAI-compatible endpoint)
# AGENT_API_KEY=

# Embeddings need an OpenAI-compatible API (DeepSeek/Anthropic have none).
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# RENDER_URL=http://localhost:8001
# TTS_URL=http://localhost:8002
